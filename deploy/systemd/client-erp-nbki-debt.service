[Unit]
Description=CRM NBKI payment deadlines and periodic debt reporting
After=client-erp.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/client-erp
EnvironmentFile=/opt/client-erp/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/client-erp/.venv/bin/python /opt/client-erp/scripts/nbki_record_debt_changes.py
