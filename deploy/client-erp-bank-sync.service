[Unit]
Description=Client ERP daily bank statement synchronization
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=clienterp
Group=clienterp
WorkingDirectory=/opt/client-erp
EnvironmentFile=/opt/client-erp/.env
ExecStart=/opt/client-erp/.venv/bin/python /opt/client-erp/scripts/run_bank_sync.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/client-erp/data
